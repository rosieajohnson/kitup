# Copy to .env.local and fill in from your Supabase project (Project Settings -> API).
# Public values are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Server-only. NEVER expose this to the browser. Used by scripts/import_catalogue.py,
# the Stripe webhook (to record purchases), and any server-side admin task. It
# bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Stripe (payments) ---
# Server-only secret key (use the TEST key, sk_test_..., while developing).
STRIPE_SECRET_KEY="sk_test_your-secret-key"
# Signing secret for the /api/webhooks/stripe endpoint. From the Stripe CLI
# (`stripe listen`) for local dev, or the dashboard webhook config in prod.
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
# Optional: used to build success/cancel URLs when no request origin is present.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Contact form email (Resend) ---
# Server-only. From https://resend.com (Developers -> API keys).
RESEND_API_KEY="re_your-key"
# Optional verified sender; defaults to Resend's onboarding sender for testing.
CONTACT_FROM_EMAIL="Kit Up <onboarding@resend.dev>"
